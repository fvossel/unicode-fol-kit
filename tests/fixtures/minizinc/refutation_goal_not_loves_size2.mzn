% Generated by unicode_fol_kit.atp.minizinc_backend.to_minizinc --
% bounded refutation search, |D| = 2, 1 sentence(s) to satisfy simultaneously.
% REFUTATION-ONLY: SATISFIABLE here witnesses a finite countermodel;
% UNSATISFIABLE proves nothing about validity at a larger domain size.

int: n = 2;
set of int: DOM = 0..n-1;

array[DOM, DOM] of var bool: p_Loves;

constraint (not forall(v_x in DOM)(exists(v_y in DOM)(p_Loves[v_x, v_y]))); % sentence 1

solve satisfy;

output [
  "UFK-SOLUTION-BEGIN\n",
  "UFK p_Loves 2 " ++ show([p_Loves[i0, i1] | i0 in DOM, i1 in DOM]) ++ "\n",
  "UFK-SOLUTION-END\n"
];

