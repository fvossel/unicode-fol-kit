include "alldifferent.mzn";

% Generated by unicode_fol_kit.atp.minizinc_backend.to_minizinc --
% bounded refutation search, |D| = 3, 5 sentence(s) to satisfy simultaneously.
% REFUTATION-ONLY: SATISFIABLE here witnesses a finite countermodel;
% UNSATISFIABLE proves nothing about validity at a larger domain size.

int: n = 3;
set of int: DOM = 0..n-1;

array[DOM] of var bool: p_P;
array[DOM] of var bool: p_Q;
var bool: p_Rain;

var DOM: k_a;
var DOM: k_b;

constraint alldifferent([k_a, k_b]);

constraint (k_a != k_b); % sentence 1
constraint (p_P[k_a] xor p_Q[k_a]); % sentence 2
constraint (p_P[k_a] <-> p_Q[k_b]); % sentence 3
constraint (p_Rain /\ (p_P[k_a] \/ (not p_Q[k_b]))); % sentence 4
constraint (p_Rain -> p_P[k_a]); % sentence 5

solve satisfy;

output [
  "UFK-SOLUTION-BEGIN\n",
  "UFK p_P 1 " ++ show([p_P[i0] | i0 in DOM]) ++ "\n",
  "UFK p_Q 1 " ++ show([p_Q[i0] | i0 in DOM]) ++ "\n",
  "UFK p_Rain 0 " ++ show(p_Rain) ++ "\n",
  "UFK k_a 0 " ++ show(k_a) ++ "\n",
  "UFK k_b 0 " ++ show(k_b) ++ "\n",
  "UFK-SOLUTION-END\n"
];

